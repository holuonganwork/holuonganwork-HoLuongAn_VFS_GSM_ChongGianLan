# Local development only. Compose requires POSTGRES_PASSWORD to be set.
POSTGRES_DB=fraud_investigation
POSTGRES_USER=fraud
POSTGRES_PASSWORD=local-development-change-me
# For Python commands on your host; Compose sets its own service hostname.
DATABASE_URL=postgresql+psycopg://fraud:local-development-change-me@localhost:5432/fraud_investigation
LOG_LEVEL=INFO
# Optional JSON override; omitted fields use documented demo defaults.
# FRAUD_RULES={"gps_max_speed_kmh":180,"weights":{"gps_spoofing":30,"repeated_trips":25,"shared_device":25,"promotion_abuse":20}}
# DECISION_POLICY={"version":"policy-v1","auto_clear_max_probability":0.1,"auto_clear_max_risk":20,"auto_fraud_min_probability":0.95,"min_confidence":0.9}
