@startuml
!include theme.puml
left to right direction
title DFD-D02 — Phân rã tiến trình 2.0: tìm và kiểm chứng bằng chứng
rectangle "E2\nKiểm soát viên" as E2 #F1F5F9
rectangle "4.0\nQuản trị quyền" as P4 #F1F5F9
rectangle "1.0\nTiếp nhận / xác minh nguồn" as P1 #F1F5F9
rectangle "3.0\nTrao đổi và quyết định" as P3 #F1F5F9
usecase "2.1\nKiểm phạm vi và\nchuẩn hóa truy vấn" as P21
usecase "2.2\nTìm nguồn, liên kết\nvà tái dựng timeline" as P22
usecase "2.3\nKiểm chứng và đánh giá\nủng hộ / phản bác" as P23
usecase "2.4\nLưu gói căn cứ\nvà lập đề xuất" as P24
database "D1\nNguồn / snapshot / chất lượng" as D1
database "D2\nHồ sơ / bằng chứng" as D2
database "D3\nGiải trình / quyết định" as D3
